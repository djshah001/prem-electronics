# ─── Server ─────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database ────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/prem_electronics

# ─── JWT ─────────────────────────────────────────────────
# Must be at least 32 characters long
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars_long
JWT_EXPIRES_IN=7d
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30

# ─── CORS ────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── Razorpay ────────────────────────────────────────────
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_optional
# Development only. Keep false in production.
ALLOW_MOCK_PAYMENTS=false

# ─── SMTP / Email ────────────────────────────────────────
# Using Mailtrap for development (https://mailtrap.io)
# OR Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, use App Password
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_mailtrap_username
SMTP_PASS=your_mailtrap_password
SMTP_FROM=noreply@premelectronics.com

# ─── Pricing Configuration ───────────────────────────────
# Tax rate as a decimal (0.18 = 18% GST). Engineering default.
TAX_RATE=0.18
TAX_MODE=exclusive
PRICING_POLICY_VERSION=gst-v1
# Required for company checkout; supplier two-digit GST state/UT code.
SUPPLIER_STATE_CODE=
# Flat shipping charge in INR display units. Engineering default.
SHIPPING_CHARGE=99
# Cart subtotal threshold (after discount) above which shipping is free. Engineering default.
SHIPPING_FREE_THRESHOLD=999

# GST taxpayer lookup: unconfigured | fixture | cleartax
GST_PROVIDER=unconfigured
GST_PROVIDER_BASE_URL=https://api.cleartax.in
GST_PROVIDER_AUTH_TOKEN=
GST_PROVIDER_TAXABLE_ENTITY_ID=
GST_LOOKUP_TIMEOUT_MS=8000
GST_VERIFICATION_TTL_HOURS=24
ALLOW_GST_FIXTURES=false

# ─── Merchant Details (Invoice & Receipts) ────────────────
MERCHANT_NAME="Prem Electronics"
MERCHANT_GSTIN=
MERCHANT_ADDRESS=
MERCHANT_PHONE=
MERCHANT_EMAIL=
BLOG_IMAGE_HOSTS=images.unsplash.com
