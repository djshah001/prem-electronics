{
  "name": "prem-electronics-server",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "tsc --outDir .test-dist --declaration false --declarationMap false --sourceMap false && node --test .test-dist/infrastructure/payment/razorpay.test.js .test-dist/infrastructure/gst/gstin.test.js .test-dist/modules/pricing/gstPricing.test.js .test-dist/modules/blogs/blogSanitizer.test.js .test-dist/modules/admin/admin.schema.test.js .test-dist/modules/communications/contentDocument.test.js .test-dist/modules/communications/campaignPolicy.test.js .test-dist/modules/invoiceMaster/invoice.renderer.test.js .test-dist/modules/banners/banners.schema.test.js",
    "test:db": "tsc --outDir .test-dist --declaration false --declarationMap false --sourceMap false && node --test .test-dist/modules/cart/cart.integration.test.js && node --test .test-dist/modules/businesses/businesses.integration.test.js && node --test .test-dist/modules/auth/auth.integration.test.js && node --test .test-dist/modules/admin/analytics.integration.test.js && node --test .test-dist/modules/admin/api.smoke.integration.test.js",
    "test:p3-db": "tsc --outDir .test-dist --declaration false --declarationMap false --sourceMap false && node --test .test-dist/modules/communications/campaign.integration.test.js",
    "db:generate": "npm run build && drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsc --outDir .test-dist --declaration false --declarationMap false --sourceMap false && node .test-dist/infrastructure/database/seed.js",
    "blogs:remediate": "tsc --outDir .test-dist --declaration false --declarationMap false --sourceMap false && node .test-dist/modules/blogs/remediateBlogs.js",
    "banners:cleanup-assets": "tsc --outDir .test-dist --declaration false --declarationMap false --sourceMap false && node .test-dist/modules/banners/cleanupBannerAssets.js"
  },
  "dependencies": {
    "@types/multer": "^2.2.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "0.45.3",
    "drizzle-zod": "^0.8.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "nodemailer": "10.0.15",
    "pdfkit": "0.20.2",
    "pg": "^8.13.1",
    "razorpay": "^2.9.6",
    "sanitize-html": "2.18.0",
    "sharp": "^0.35.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "^8.11.10",
    "@types/sanitize-html": "2.16.0",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
