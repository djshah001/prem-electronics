{
  "name": "prem-electronics",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --names \"SERVER,CLIENT\" --prefix-colors \"blue,green\" \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix server && npm run build --prefix client",
    "install:all": "npm install && npm install --prefix server && npm install --prefix client",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:start:api": "pm2 start ecosystem.config.cjs --only prem-electronics-api --env production",
    "pm2:start:client": "pm2 start ecosystem.config.cjs --only prem-electronics-client --env production",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs --env production",
    "pm2:reload": "pm2 reload ecosystem.config.cjs --env production",
    "pm2:delete": "pm2 delete ecosystem.config.cjs",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs",
    "pm2:monit": "pm2 monit",
    "pm2:save": "pm2 save"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "pm2": "^7.1.2"
  }
}
